{
  "name": "labour-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node-server.ts",
    "start": "tsx src/node-server.ts",
    "test:auth": "RATE_LIMIT_DISABLED=1 tsx src/api/test-auth.ts",
    "test:ratelimit": "tsx src/api/test-ratelimit.ts",
    "test:requests": "RATE_LIMIT_DISABLED=1 tsx src/api/test-requests.ts",
    "test:tasks": "RATE_LIMIT_DISABLED=1 tsx src/api/test-tasks.ts",
    "test:quotes": "RATE_LIMIT_DISABLED=1 tsx src/api/test-quotes.ts",
    "test:assignments": "RATE_LIMIT_DISABLED=1 tsx src/api/test-assignments.ts",
    "test:milestones": "RATE_LIMIT_DISABLED=1 tsx src/api/test-milestones.ts",
    "test:task-work": "RATE_LIMIT_DISABLED=1 tsx src/api/test-task-work.ts",
    "live:paystack": "RATE_LIMIT_DISABLED=1 tsx src/dev/live-paystack.ts",
    "live:payout": "RATE_LIMIT_DISABLED=1 tsx src/dev/live-payout.ts",
    "reconcile": "tsx src/dev/reconcile-paystack.ts",
    "deploy:check": "tsx src/dev/deploy-check.ts",
    "smoke": "tsx src/dev/smoke.ts",
    "test:work": "STORAGE_DRIVER=memory RATE_LIMIT_DISABLED=1 tsx src/api/test-work.ts",
    "test:changes": "RATE_LIMIT_DISABLED=1 tsx src/api/test-changes.ts",
    "test:threads": "RATE_LIMIT_DISABLED=1 tsx src/api/test-threads.ts",
    "test:discovery": "RATE_LIMIT_DISABLED=1 tsx src/api/test-discovery.ts",
    "test:entry": "tsx src/api/test-entry.ts",
    "test:paystack": "tsx src/payments/test-paystack.ts",
    "test:money-views": "PAYMENTS_PROVIDER=sandbox RATE_LIMIT_DISABLED=1 tsx src/api/test-money-views.ts",
    "test:payments": "PAYMENTS_PROVIDER=sandbox RATE_LIMIT_DISABLED=1 tsx src/api/test-payments.ts",
    "test:checkout": "PAYMENTS_PROVIDER=sandbox RATE_LIMIT_DISABLED=1 tsx src/api/test-checkout.ts",
    "test:admin-view": "PAYMENTS_PROVIDER=sandbox RATE_LIMIT_DISABLED=1 tsx src/api/test-admin-view.ts",
    "test:payouts": "PAYMENTS_PROVIDER=sandbox RATE_LIMIT_DISABLED=1 tsx src/api/test-payouts.ts",
    "test:all": "npm run typecheck && npm run test:auth && npm run test:ratelimit && npm run test:requests && npm run test:discovery && npm run test:threads && npm run test:changes && npm run test:work && npm run test:tasks && npm run test:quotes && npm run test:assignments && npm run test:milestones && npm run test:task-work && npm run test:entry && npm run test:paystack && npm run test:payments && npm run test:money-views && npm run test:checkout && npm run test:payouts && npm run test:admin-view && npm run test:blueprint && npm run db:test-guards",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:guards": "tsx src/db/apply-guards.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:lockdown": "tsx src/db/apply-lockdown.ts",
    "db:test-guards": "tsx src/db/test-guards.ts",
    "db:studio": "drizzle-kit studio",
    "test:intake": "STORAGE_DRIVER=memory INTAKE_MAX_ATTACHMENTS=3 RATE_LIMIT_DISABLED=1 tsx src/api/test-intake.ts",
    "storage:smoke": "tsx src/storage-smoke.ts",
    "test:blueprint": "STORAGE_DRIVER=memory RATE_LIMIT_DISABLED=1 tsx src/api/test-blueprint.ts",
    "db:seed:blueprint": "tsx src/db/seed-blueprint.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.0",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.13",
    "postgres": "^3.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
