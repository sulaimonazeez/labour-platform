# Runtime (Vercel): Supabase POOLED connection string, transaction mode (port 6543)
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Migrations / guards / seed: DIRECT connection (port 5432).
# If the direct host is unreachable from your network (IPv6-only), use the
# Supabase "session pooler" string instead (port 5432 on the pooler host).
DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Optional: comma-separated web origins allowed to call the API from a browser.
# CORS_ORIGINS=https://app.example.com,http://localhost:3000

# Payments. "sandbox" (default) is an in-process fake and is refused when NODE_ENV=production.
# PAYMENTS_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=sk_test_...      # use a TEST key until the live checklist in docs/NEXT_STEPS.md is done
# PAYMENTS_CALLBACK_URL=https://app.example.com/payments/return   # where the gateway sends the customer back
# PAYSTACK_BASE_URL=                   # leave unset; only for pointing tests at a mock gateway

# Platform staff (comma-separated user ids). Required to use /admin/* (approve payouts, attention queue). Empty = nobody.
# PLATFORM_ADMIN_USER_IDS=
# Optional tuning (defaults shown)
# PAYMENT_PENDING_TTL_MINUTES=30
# PAYOUT_MIN_MINOR=10000
# PAYOUT_ACCOUNT_COOLDOWN_HOURS=24
# Never put PAYSTACK_PUBLIC_KEY here: the server does not use it.

# Request photos/videos (private object storage). SERVER-SIDE SECRETS: never expose the service-role key to the browser.
# Create a PRIVATE bucket named request-media in Supabase Storage (or set STORAGE_BUCKET).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=request-media

# Server / dev (all optional)
# PORT=8787                            # node-server.ts listen port
# NODE_ENV=development                 # production refuses the sandbox payment provider
# RATE_LIMIT_DISABLED=1                # tests only: never in production
# SANDBOX_WEBHOOK_SECRET=              # sandbox payment provider only
# STORAGE_DRIVER=supabase              # supabase (default when SUPABASE_* are set) | memory (tests) | none
# INTAKE_MAX_ATTACHMENTS=12            # photos/videos per request

# ── Blueprint layer: optional intelligence and background jobs ─────────────────────────────────────────────────
# Everything below is OPTIONAL. With none of it set the platform runs fully, deterministically, with no AI.
# AI_PROVIDER=none                     # none (default) | mock (tests/demos) | anthropic
# ANTHROPIC_API_KEY=                   # SERVER-SIDE SECRET. Required only for AI_PROVIDER=anthropic
# ANTHROPIC_MODEL=                     # required for anthropic: put the exact model id you want to pay for
# AI_TIMEOUT_MS=15000
# AI_DAILY_LIMIT=30                    # AI calls per person per day (PRD §147)
# AI_PRICE_IN_MICROS_PER_MTOK=0        # optional cost tracking, in your own micro-currency per million tokens
# AI_PRICE_OUT_MICROS_PER_MTOK=0
# TRANSLATION_PROVIDER=none            # none (default) | mock | ai  (ai routes through AI_PROVIDER, metered and logged)
# SPEECH_PROVIDER=none                 # none (default) | mock  (add a real adapter in src/ai/providers.ts)
# MIN_GROUP_SIZE=5                     # analytics never show groups smaller than this (PRD §121)
# CRON_SECRET=                         # enables POST /jobs/recurring, /jobs/credentials, /jobs/cleanup (header x-cron-secret)

